{
	"lock": false,
	"exports": {},
	"tasks": {
		"start": "deno run -A --watch src/main.ts",
		"test": "deno test -A",
		"build": "deno run -RW --allow-run scripts/build.ts"
	},
	"imports": {
		"@li/http-saver": "jsr:@li/http-saver@^0.5.1",
		"@std/assert": "jsr:@std/assert@^1.0.15",
		"@std/http": "jsr:@std/http@^1.0.21",
		"@std/media-types": "jsr:@std/media-types@^1.1.0",
		"@std/path": "jsr:@std/path@^1.1.2",
		"handlebars": "npm:handlebars@^4.7.8",
		"twemoji": "./src/client/vendor/twemoji.mjs"
	},
	"fmt": {
		"semiColons": false,
		"useTabs": true,
		"lineWidth": 120,
		"indentWidth": 4,
		"singleQuote": true,
		"proseWrap": "preserve",
		"exclude": []
	},
	"compilerOptions": { "strict": true },
	"lint": {
		"exclude": [],
		"rules": {
			"tags": ["recommended"],
			"exclude": [],
			"include": []
		}
	},
	"exclude": []
}
